# 예시 파일입니다. 실제 값은 채우지 말고 변수명만 유지하세요.
# 실제 값은 저장소 루트의 .env 파일(gitignore 대상)에 작성합니다.

# --- api-provider-playground : OpenAI / OpenRouter API 비교 실험 ---
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- rag-experiments : FAQ / 상품추천 RAG 답변 생성 ---
# 기본은 로컬 Ollama(키 불필요). Ollama가 없을 때 아래 키로 fallback.
ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY 는 위 항목과 공용

# --- paper-review-notion : (3단계) Notion 발행용 — 아직 미사용 ---
# NOTION_API_KEY=

# --- smilebiz-van : SMARTRO VAN API ---
SMARTRO_VAN_API_KEY=
# 조회할 단말기번호 10자리 (02·03·04 노트북에서 사용, 01 노트북은 비어 있어도 됨)
SMARTRO_VAN_TERMID=
# (선택) 특정 가맹점만 좁혀 조회할 때. 비우면 사업자 전체 범위
SMARTRO_VAN_COMP_NO=
SMARTRO_VAN_COMP_IDX=

# (popbill-bank-test 는 프로젝트 폴더의 popbill-bank-test/.env 를 별도로 사용합니다.
#  popbill-bank-test/.env.example 참고)

# --- voice-data-pipeline : 통화 녹음이 있는 폴더 경로 (로컬/NAS) ---
VOICE_NAS_PATH=
