# 팝빌에서 발급받은 API 인증정보
POPBILL_LINK_ID=
POPBILL_SECRET_KEY=
# 팝빌 회원 사업자번호 (10자리), 회원 아이디 (선택)
POPBILL_CORP_NUM=
POPBILL_USER_ID=
POPBILL_IS_TEST=true
# 팝빌 은행 기관코드 4자리, 팝빌에 미리 등록한 계좌번호
POPBILL_BANK_CODE=
POPBILL_ACCOUNT_NUMBER=
# yyyyMMdd. 둘 다 비워두면 한국시간 어제~오늘 조회
QUERY_START_DATE=
QUERY_END_DATE=
# 수집 대기 제한 / 확인 간격 (초)
POLL_TIMEOUT_SECONDS=180
POLL_INTERVAL_SECONDS=3
